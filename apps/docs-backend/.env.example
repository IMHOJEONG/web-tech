PORT=8000
CONTENT_API_TOKEN=replace-with-a-long-random-secret
# NAS/Compose에서는 CONTENT_API_TOKEN 대신 secret file을 사용합니다.
CONTENT_API_TOKEN_FILE=
CONTENT_DIR=./content/posts
CONTENT_ASSET_BASE_URL=https://assets.heap-forge.app

# Optional web push experiment. Keep disabled until configured.
PUSH_ENABLED=false
PUSH_API_TOKEN=
PUSH_API_TOKEN_FILE=
PUSH_ADMIN_TOKEN=
PUSH_ADMIN_TOKEN_FILE=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PRIVATE_KEY_FILE=
PUSH_VAPID_SUBJECT=mailto:replace-with-your-contact@example.com
PUSH_STORE_FILE=./data/push-subscriptions.json
