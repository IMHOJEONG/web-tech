# Base local example
# Prefer copying this file into `.env.local` for machine-specific overrides.
# Railway production/staging should use dashboard Variables instead of an env file.

APP_ENV=development
PORT=4000
VULN_RADAR_API_TOKEN=
CORS_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
INGEST_LOOKBACK_HOURS=24
INGEST_MAX_LOOKBACK_HOURS=240
INGEST_SCHEDULER_ENABLED=true
INGEST_SOURCE_TIMEOUT_MS=60000
INGEST_SYNC_INTERVAL_MINUTES=1440
INGEST_SYNC_ON_STARTUP=false
NVD_API_KEY=
NVD_REQUEST_MAX_RETRIES=2
NVD_REQUEST_PAGE_DELAY_MS=6000
NVD_REQUEST_RETRY_DELAY_MS=1500
NVD_RESULTS_PER_PAGE=200
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vuln_radar
