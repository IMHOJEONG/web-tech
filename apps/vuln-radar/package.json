{
  "name": "vuln-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @web-tech/ui build",
    "dev": "vp dev --port 3000",
    "lint": "eslint \"**/*.{ts,tsx,mjs}\" --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint/",
    "prebuild": "pnpm --filter @web-tech/ui build",
    "build": "vp build",
    "preview": "vp preview --host 0.0.0.0 --port 3000",
    "start": "vp preview --host 0.0.0.0 --port 3000",
    "test:lib": "node --experimental-strip-types --test ./src/pages/feed/model/*.test.ts ./src/pages/overview/ui/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:fe-box",
    "@tanstack/react-router": "catalog:fe-box",
    "@supabase/supabase-js": "catalog:web",
    "@web-tech/ui": "workspace:*",
    "@xyflow/react": "catalog:web",
    "class-variance-authority": "catalog:web",
    "cloudflare": "catalog:web",
    "clsx": "catalog:",
    "dayjs": "catalog:web",
    "effect": "catalog:web",
    "ky": "catalog:",
    "lucide-react": "catalog:",
    "overlay-kit": "catalog:web",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:web",
    "sass": "catalog:",
    "tailwind-merge": "catalog:web",
    "tailwindcss": "catalog:",
    "use-debounce": "catalog:web",
    "zod": "catalog:web"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:fe-box",
    "@web-tech/eslint-config": "workspace:*",
    "@web-tech/typescript-config": "workspace:*",
    "postcss": "^8.5.10",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "type-fest": "catalog:",
    "typescript": "catalog:"
  }
}
