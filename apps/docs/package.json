{
    "name": "docs",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm --filter @web-tech/docs-content-contract build && pnpm --filter @web-tech/ui build",
        "dev": "next dev --port 3001",
        "dev:e2e": "pnpm --filter @web-tech/docs-content-contract build && pnpm --filter @web-tech/ui build && next dev --port 3001 --hostname 127.0.0.1",
        "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx,mts}\" --max-warnings 0",
        "prevalidate:content": "pnpm --filter @web-tech/docs-content-contract build",
        "validate:content": "node ./scripts/validate-content.mjs && node ./scripts/validate-content-style.mjs",
        "pretest:content": "pnpm --filter @web-tech/docs-content-contract build",
        "revalidate:content-cache": "node ./scripts/revalidate-content-cache.mjs",
        "test:content": "node --test ./scripts/validate-content.test.mjs ./scripts/validate-content-style.test.mjs && pnpm validate:content",
        "pretest:crp-lab:browser": "tsc -p tsconfig.crp-e2e.json",
        "test:crp-lab:browser": "playwright test --config=playwright.crp.config.ts",
        "pretest:activity-lab": "pnpm --filter @web-tech/ui build && tsc -p tsconfig.activity-e2e.json",
        "test:activity-lab": "playwright test --config=playwright.activity.config.ts",
        "test:e2e": "playwright test",
        "test:article:prod": "playwright test --config=playwright.article.config.ts",
        "check:prod-routes": "node ./scripts/check-prod-routes.mjs",
        "pretest:better-stack:local": "pnpm --filter @web-tech/docs-content-contract build",
        "test:better-stack:local": "node ./scripts/test-better-stack-local.mjs",
        "test:cache:prod": "node ./scripts/test-content-cache-prod.mjs",
        "pretest:lib": "pnpm --filter @web-tech/docs-content-contract build",
        "test:lib": "pnpm typecheck:node-test && node --experimental-strip-types --test ./lib/*.test.ts ./feature/callout/model/*.test.ts ./feature/code-block/lib/*.test.ts ./shared/config/*.test.ts ./widgets/docs-index/model/*.test.ts ./widgets/content-hub/model/*.test.ts",
        "prebuild": "pnpm --filter @web-tech/docs-content-contract build && pnpm --filter @web-tech/ui build && pnpm validate:content",
        "build": "next build",
        "start": "next start",
        "rm:next-server": "rm -rf .next",
        "pretypecheck": "pnpm --filter @web-tech/docs-content-contract build",
        "typecheck": "tsc --noEmit",
        "typecheck:node-test": "tsc -p tsconfig.node-test.json"
    },
    "dependencies": {
        "@mdx-js/loader": "catalog:docs",
        "@mdx-js/react": "catalog:docs",
        "@next/mdx": "catalog:docs",
        "@shikijs/rehype": "^4.0.2",
        "@tailwindcss/postcss": "catalog:",
        "@types/mdx": "catalog:docs",
        "@types/sanitize-html": "catalog:docs",
        "@vercel/analytics": "^2.0.1",
        "@web-tech/docs-content-contract": "workspace:*",
        "@web-tech/ui": "workspace:*",
        "@xyflow/react": "catalog:docs",
        "better-auth": "catalog:docs",
        "clsx": "catalog:",
        "entities": "catalog:docs",
        "esbuild": "^0.28.0",
        "fast-glob": "catalog:docs",
        "gray-matter": "catalog:docs",
        "ky": "catalog:",
        "lucide-react": "catalog:",
        "mdx-bundler": "catalog:docs",
        "next": "catalog:docs",
        "next-intl": "catalog:docs",
        "next-mdx-remote-client": "catalog:docs",
        "nextjs-toploader": "catalog:docs",
        "overlay-kit": "catalog:docs",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-icons": "^5.5.0",
        "rehype-autolink-headings": "catalog:docs",
        "rehype-katex": "catalog:docs",
        "rehype-slug": "catalog:docs",
        "remark-flexible-toc": "catalog:docs",
        "remark-gfm": "catalog:docs",
        "remark-toc": "catalog:docs",
        "sanitize-html": "catalog:docs",
        "sass": "catalog:",
        "shiki": "^4.0.2",
        "to-vfile": "catalog:docs",
        "tw-animate-css": "catalog:",
        "use-debounce": "catalog:docs",
        "vfile": "catalog:docs",
        "vfile-matter": "catalog:docs",
        "web": "catalog:docs",
        "zod": "^4.4.2",
        "zustand": "catalog:docs"
    },
    "devDependencies": {
        "@eslint/eslintrc": "catalog:",
        "@eslint/js": "catalog:",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@playwright/test": "catalog:docs",
        "@typescript/native-preview": "7.0.0-dev.20260430.1",
        "@web-tech/eslint-config": "workspace:*",
        "@web-tech/tailwind-config": "workspace:*",
        "@web-tech/typescript-config": "workspace:*",
        "autoprefixer": "^10.4.24",
        "eslint-config-next": "15.5.2",
        "globals": "^16.5.0",
        "postcss": "catalog:",
        "tailwindcss": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:"
    }
}
