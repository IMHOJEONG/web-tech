BETTER_AUTH_SECRET=replace-with-your-secret
BETTER_AUTH_URL=http://localhost:3000

# Public canonical origin used by robots.txt and sitemap.xml
DOCS_SITE_URL=https://heap-forge.app
NEXT_PUBLIC_SITE_URL=

# Content metadata API base URL
# Local example: http://localhost:8000
# Deploy example: https://content.example.com
BLOG_CONTENT_API_BASE_URL=http://localhost:8000

# Optional split by network role
# If both are present, `PUBLIC` is preferred over `INTERNAL`
BLOG_CONTENT_API_BASE_URL_INTERNAL=
BLOG_CONTENT_API_BASE_URL_PUBLIC=
BLOG_CONTENT_API_TOKEN=

BLOG_CONTENT_API_POSTS_PATH=/api/posts

# Content body HTML base URL
# In most cases this is the same host as BLOG_CONTENT_API_BASE_URL
BLOG_CONTENT_MARKDOWN_BASE_URL=http://localhost:8000

# Optional split by network role
# If both are present, `PUBLIC` is preferred over `INTERNAL`
BLOG_CONTENT_MARKDOWN_BASE_URL_INTERNAL=
BLOG_CONTENT_MARKDOWN_BASE_URL_PUBLIC=

BLOG_CONTENT_MARKDOWN_PATH_PREFIX=/posts

# Optional thumbnail / asset host for remote metadata.
# Relative remote thumbnails are resolved only against this asset base.
# Prefer the server-only PUBLIC key when possible.
BLOG_CONTENT_ASSET_BASE_URL_PUBLIC=
BLOG_CONTENT_ASSET_BASE_URL=
BLOG_CONTENT_ASSET_BASE_URL_INTERNAL=
NEXT_PUBLIC_BLOG_CONTENT_ASSET_BASE_URL_PUBLIC=

# Default ISR window for remote content fetches
BLOG_CONTENT_REVALIDATE_SECONDS=300
BLOG_CONTENT_API_TIMEOUT_MS=2500

# Remote index merge is enabled by default. Set false only for local-only rendering.
BLOG_CONTENT_INCLUDE_REMOTE_INDEX=true
