{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsxImportSource": "react",
    "declarationMap": false
  },
  "include": [
    "common/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "layout/**/*.ts",
    "layout/**/*.tsx",
    "lib/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-temp", "turbo"]
}
