{
  "name": "@web-tech/ui",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "prepack": "pnpm build",
    "dev": "pnpm build && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint \"**/*.{ts,tsx,mts}\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "generate:component": "turbo gen react-component"
  },
  "devDependencies": {
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@turbo/gen": "^2.8.8",
    "@types/eslint": "^9.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "postcss": "catalog:",
    "@web-tech/eslint-config": "workspace:*",
    "@web-tech/tailwind-config": "workspace:*",
    "@web-tech/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@emotion/react": "catalog:ui",
    "@emotion/styled": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "cn": "catalog:ui",
    "dayjs": "catalog:ui",
    "lucide-react": "catalog:",
    "motion": "catalog:ui",
    "react-icons": "^5.5.0",
    "recharts": "catalog:ui",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.6 <20",
    "react-dom": ">=19.2.6 <20",
    "tailwindcss": "^4.1.18"
  },
  "exports": {
    "./styles.css": "./dist/styles/index.css",
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./components/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    }
  }
}
