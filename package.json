{
  "name": "web-tech",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:web-apps": "turbo build --filter=docs --filter=vuln-radar",
    "check:vuln-radar:dev": "bash ./scripts/check-vuln-radar-dev.sh",
    "check:web-apps": "pnpm lint:web-apps && pnpm typecheck:web-apps && pnpm build:web-apps",
    "dev": "turbo dev",
    "dev:vuln-radar": "turbo dev --filter=vuln-radar",
    "dev:vuln-radar:full": "turbo dev --filter=vuln-radar --filter=vuln-radar-backend",
    "dev:docs": "turbo dev --filter=docs",
    "start:vuln-radar": "turbo start --filter=vuln-radar",
    "start:vuln-radar:full": "turbo start --filter=vuln-radar --filter=vuln-radar-backend",
    "start:docs": "turbo start --filter=docs",
    "dev:vuln-radar-backend": "turbo dev --filter=vuln-radar-backend",
    "start:vuln-radar-backend": "turbo start --filter=vuln-radar-backend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "lint:web-apps": "turbo lint --filter=docs --filter=vuln-radar",
    "test:repo": "node --test ./scripts/validate-catalog-references.test.mjs",
    "branch:sync-feature": "bash ./scripts/sync-feature-branches.sh",
    "branch:sync-feature:apply": "bash ./scripts/sync-feature-branches.sh --apply",
    "branch:sync-feature:push": "bash ./scripts/sync-feature-branches.sh --apply --push",
    "lint:commit:head": "commitlint --from HEAD~1 --to HEAD --verbose",
    "typecheck:web-apps": "turbo typecheck --filter=docs --filter=vuln-radar",
    "validate:catalog": "node ./scripts/validate-catalog-references.mjs",
    "rm:pnpm-store": "rm -rf \"$(pnpm store path)\"",
    "prepare": "simple-git-hooks",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "vercel:deploy:vuln-radar": "vercel --cwd apps/vuln-radar && vercel deploy",
    "vercel:deploy:docs": "vercel --cwd apps/docs && vercel deploy",
    "update:simple-git-hooks": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/compat": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "commit-msg": "./scripts/pnpmw.sh exec commitlint --edit \"$1\"",
    "pre-commit": "./scripts/pnpmw.sh format && echo 'ok'",
    "pre-push": "./scripts/pnpmw.sh format"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
