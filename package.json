{
  "name": "web-tech",
  "private": true,
  "scripts": {
    "check:node": "node ./scripts/check-node-runtime.mts",
    "build": "turbo build",
    "build:web-apps": "turbo build --filter=docs --filter=vuln-radar",
    "check:vuln-radar:dev": "bash ./scripts/check-vuln-radar-dev.sh",
    "verify:vuln-radar:integration": "tsc -p tsconfig.vuln-integration.json && node --experimental-strip-types ./scripts/verify-vuln-radar-integration.mts",
    "check:web-apps": "pnpm lint:web-apps && pnpm typecheck:web-apps && pnpm build:web-apps",
    "dev": "turbo dev",
    "dev:vuln-radar": "turbo dev --filter=vuln-radar",
    "dev:vuln-radar:full": "turbo dev --filter=vuln-radar --filter=vuln-radar-backend",
    "dev:docs": "turbo dev --filter=docs",
    "dev:crp-lab": "node --experimental-strip-types docs/examples/critical-rendering-path-lab/server.ts",
    "start:vuln-radar": "turbo start --filter=vuln-radar",
    "start:vuln-radar:full": "turbo start --filter=vuln-radar --filter=vuln-radar-backend",
    "start:docs": "turbo start --filter=docs",
    "dev:vuln-radar-backend": "turbo dev --filter=vuln-radar-backend",
    "start:vuln-radar-backend": "turbo start --filter=vuln-radar-backend",
    "dev:docs-backend": "turbo dev --filter=docs-backend",
    "start:docs-backend": "turbo start --filter=docs-backend",
    "lint:docs-backend": "turbo lint --filter=docs-backend",
    "test:docs-backend": "turbo test --filter=docs-backend",
    "typecheck:docs-backend": "turbo typecheck --filter=docs-backend",
    "check:docs-backend": "pnpm --filter docs-backend check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed:check": "node ./scripts/check-staged-format.mjs",
    "format:staged:check": "node ./scripts/check-staged-format.mjs --staged",
    "validate:docs": "node ./scripts/check-documentation.mjs",
    "lint": "turbo lint",
    "lint:web-apps": "turbo lint --filter=docs --filter=vuln-radar",
    "test:repo": "node --experimental-strip-types --test ./scripts/*.test.mjs ./scripts/*.test.mts",
    "branch:sync-feature": "bash ./scripts/sync-feature-branches.sh",
    "branch:sync-feature:apply": "bash ./scripts/sync-feature-branches.sh --apply",
    "branch:sync-feature:push": "bash ./scripts/sync-feature-branches.sh --apply --push",
    "lint:commit:head": "commitlint --from HEAD~1 --to HEAD --verbose",
    "pr:squash": "node --experimental-strip-types ./scripts/squash-merge.mts",
    "test:squash": "node --experimental-strip-types --test ./scripts/squash-merge.test.mts",
    "typecheck:squash": "tsc -p tsconfig.squash-merge.json",
    "typecheck:web-apps": "turbo typecheck --filter=docs --filter=vuln-radar",
    "validate:catalog": "node ./scripts/validate-catalog-references.mjs",
    "rm:pnpm-store": "rm -rf \"$(pnpm store path)\"",
    "prepare": "simple-git-hooks",
    "test": "turbo test",
    "test:crp-lab": "pnpm typecheck:crp-lab && node --experimental-strip-types --test docs/examples/critical-rendering-path-lab/server.test.ts",
    "test:crp-lab:browser": "pnpm --filter docs test:crp-lab:browser",
    "typecheck": "turbo typecheck",
    "typecheck:toolchain": "tsc -p tsconfig.toolchain.json",
    "typecheck:crp-lab": "tsc -p docs/examples/critical-rendering-path-lab/tsconfig.json",
    "vercel:deploy:vuln-radar": "vercel --cwd apps/vuln-radar && vercel deploy",
    "vercel:deploy:docs": "vercel --cwd apps/docs && vercel deploy",
    "update:simple-git-hooks": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/compat": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "commit-msg": "./scripts/pnpmw.sh exec commitlint --edit \"$1\"",
    "pre-commit": "./scripts/pnpmw.sh format:staged:check && ./scripts/pnpmw.sh validate:docs --staged"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0"
}
