{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BLOG_CONTENT_API_BASE_URL",
    "BLOG_CONTENT_API_BASE_URL_INTERNAL",
    "BLOG_CONTENT_API_BASE_URL_PUBLIC",
    "BLOG_CONTENT_API_POSTS_PATH",
    "BLOG_CONTENT_API_TIMEOUT_MS",
    "BLOG_CONTENT_API_TOKEN",
    "BLOG_CONTENT_ASSET_BASE_URL",
    "BLOG_CONTENT_ASSET_BASE_URL_INTERNAL",
    "BLOG_CONTENT_ASSET_BASE_URL_PUBLIC",
    "BLOG_CONTENT_MARKDOWN_BASE_URL",
    "BLOG_CONTENT_MARKDOWN_BASE_URL_INTERNAL",
    "BLOG_CONTENT_MARKDOWN_BASE_URL_PUBLIC",
    "BLOG_CONTENT_MARKDOWN_PATH_PREFIX",
    "BLOG_CONTENT_REVALIDATE_SECONDS",
    "CLOUDFLARE_API_TOKEN",
    "CI",
    "DOCS_E2E_PORT",
    "DOCS_ENABLE_REACT_INSPECTION",
    "DOCS_PROD_CHECK_BASE_URL",
    "DOCS_PROD_CHECK_MAX_TOTAL_MS",
    "DOCS_PROD_CHECK_ROUTES",
    "DOCS_PROD_CHECK_TIMEOUT_MS",
    "DOCS_SITE_URL",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "globalPassThroughEnv": ["COREPACK_HOME"]
}
