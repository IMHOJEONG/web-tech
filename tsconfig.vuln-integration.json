{
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@playwright/test": ["./apps/docs/node_modules/@playwright/test"],
      "@prisma/adapter-pg": [
        "./apps/vuln-radar-backend/node_modules/@prisma/adapter-pg"
      ]
    }
  },
  "include": [
    "scripts/verify-vuln-radar-integration.mts",
    "scripts/verify-vuln-radar-viteplus.mts",
    "scripts/analyze-vuln-radar-lockfile.mts",
    "scripts/analyze-vuln-radar-lockfile.test.mts",
    "scripts/verify-viteplus-consumer-impact.mts",
    "scripts/viteplus-dependency-policy.test.mts",
    "scripts/verification-baseline.mts",
    "scripts/verification-baseline.test.mts",
    "scripts/verification-cleanup.mts",
    "scripts/verification-cleanup.test.mts"
  ]
}
